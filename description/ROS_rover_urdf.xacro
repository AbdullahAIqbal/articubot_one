<?xml version="1.0" ?>
<robot name="ROS_rover_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find ROS_rover_urdf_description)/urdf/materials.xacro" />
<xacro:include filename="$(find ROS_rover_urdf_description)/urdf/ROS_rover_urdf.trans" />
<xacro:include filename="$(find ROS_rover_urdf_description)/urdf/ROS_rover_urdf.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="-1 0.12224166560310168 0.08643892236095495" rpy="0 0 0"/>
    <mass value="34.90606826800328"/>
    <inertia ixx="0.114886" iyy="0.239343" izz="0.249193" ixy="0.000401" iyz="-0.000589" ixz="0.025841"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

