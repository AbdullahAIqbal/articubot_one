<joint name="Revolute 24" type="continuous">
  <origin xyz="-0.109883 0.037 0.041686" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Right_wheel_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="Revolute 25" type="continuous">
  <origin xyz="-0.109883 0.2086 0.041686" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Left_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 26" type="continuous">
  <origin xyz="0.05652 0.121748 0.027021" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="_front_ball_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="Rigid 27" type="fixed">
  <origin xyz="0.122495 0.122725 0.086129" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Cam_1"/>
</joint>

<joint name="Rigid 28" type="fixed">
  <origin xyz="-0.024813 0.122765 0.162152" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Lidar_1"/>
</joint>

</robot>
