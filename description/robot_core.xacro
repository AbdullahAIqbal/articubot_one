<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  >

    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="$(find ROS_rover_urdf_description)/urdf/materials.xacro" />
    <xacro:include filename="$(find ROS_rover_urdf_description)/urdf/ROS_rover_urdf.trans" />
    <xacro:include filename="$(find ROS_rover_urdf_description)/urdf/ROS_rover_urdf.gazebo" />


    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1" />
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1" />
    </material>

    <material name="black">
        <color rgba="0 0 0 1" />
    </material>

    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

<!-- BASE LINK -->

    <link name="base_link">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </link>

    <!-- BASE_FOOTPRINT LINK -->

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

<!-- CHASSIS LINK -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="0.108526747687202506 -0.12224166560310168 -0.08643892236095495"/>
    </joint>

    <link name="chassis">
        <inertial>
            <origin xyz="-0.018526747687202506 0.12224166560310168 0.08643892236095495" rpy="0 0 0"/>
            <mass value="34.90606826800328"/>
            <inertia ixx="0.114886" iyy="0.239343" izz="0.249193" ixy="0.000401" iyz="-0.000589" ixz="0.025841"/>
          </inertial>
          <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
          </visual>
          <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
          </collision>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo>

<!-- LEFT WHEEL LINK-->

    <joint name="left_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="left_wheel"/>
        <origin xyz="-0.109883 0.2086 0.041686" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_wheel">
        <inertial>
            <origin xyz="4.24215932839922e-07 0.01849999999999999 8.092045233193401e-08" rpy="0 0 0"/>
            <mass value="1.3878753666636712"/>
            <inertia ixx="0.000686" iyy="0.001055" izz="0.000686" ixy="0.0" iyz="0.0" ixz="-0.0"/>
          </inertial>
          <visual>
            <origin xyz="0.109883 -0.2086 -0.041686" rpy="0 0 0"/>
            <geometry>
              <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/Left_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue"/>
          </visual>
          <collision>
            <origin xyz="0.109883 -0.2086 -0.041686" rpy="0 0 0"/>
            <geometry>
              <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/Left_wheel_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
          </collision>
    </link>

    <gazebo reference="left_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>

<!-- RIGHT WHEEL LINK-->

<joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.109883 0.037 0.041686" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="right_wheel"/>
    <axis xyz="0.0 1.0 0.0"/>
</joint>

<link name="right_wheel">
    <inertial>
        <origin xyz="4.24215932839922e-07 -0.018500000000000003 8.09204523458118e-08" rpy="0 0 0"/>
        <mass value="1.3878753666636718"/>
        <inertia ixx="0.000686" iyy="0.001055" izz="0.000686" ixy="-0.0" iyz="0.0" ixz="-0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.109883 -0.037 -0.041686" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/Right_wheel_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0.109883 -0.037 -0.041686" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/Right_wheel_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
</link>

<gazebo reference="right_wheel">
    <material>Gazebo/Blue</material>
</gazebo>

<!-- CASTER WHEEL LINK-->

<joint name="caster_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child link="castor_wheel"/>
    <origin xyz="0.05652 0.121748 0.027021" rpy="0 0 0"/>
    <axis xyz="0.0 0.0 -1.0"/>
</joint>

<link name="castor_wheel">
    <inertial>
        <origin xyz="2.7755575615628914e-17 -1.4670485243284404e-08 3.1211140116491065e-07" rpy="0 0 0"/>
        <mass value="0.4809809344697313"/>
        <inertia ixx="0.000115" iyy="0.000115" izz="0.000115" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="-0.05652 -0.121748 -0.027021" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/_front_ball_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="-0.05652 -0.121748 -0.027021" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ROS_rover_urdf_description)/meshes/_front_ball_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
</link>

<gazebo reference="castor_wheel">
    <material>Gazebo/Black</material>
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
</gazebo>


</robot>